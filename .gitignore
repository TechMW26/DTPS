# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Gradle / Android generated files
**/.gradle/
**/build/
!.gradle/build/  # allow root gradle directory (not generated)

# Android native build outputs
Store Apps/android/build-output/
mobile-app/android/app/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Xcode user data
**/xcuserdata/
*.xcuserstate

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Generated reports
/reports/
/.migration-backups/

# Temp files and directories
.tmp/
*.tmp

# Release binaries
*.aab
*.apk

# Test scripts at root
/test-*.js

# IDE
.idea/
*.swp
*.swo
.env*.local
